<Window x:Class="CollarControl.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CollarControl"
        mc:Ignorable="d"
        Title="CollarControl Login" Height="370" Width="350" FontSize="18" Background="#323232">
    <Border BorderThickness="5">
        <TabControl Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" Height="auto" Background="#323232">
            <TabItem>
                <TabItem.Header>
                    Login
                </TabItem.Header>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="20"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Column="1" Grid.Row="1" Content="Username"/>
                    <TextBox Grid.Column="2" Grid.Row="1" Margin="5" x:Name="UsernameInput" Width="200"/>

                    <Label Grid.Column="1" Grid.Row="2" Content="Password"/>
                    <PasswordBox Grid.Column="2" Grid.Row="2" Margin="5" x:Name="PasswordInput" Width="200"/>

                    <Grid Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="RecoveryButton" FontWeight="SemiBold" FontSize="12" Content="I forgot my password" Margin="2"/>
                        <Button Grid.Column="1" x:Name="LoginButton" FontWeight="SemiBold" IsEnabled="False" FontSize="12" Content="Login" Margin="2" Click="OnLoginButtonClicked"/>
                    </Grid>

                    <TextBlock Grid.Column="1" Grid.Row="5" Grid.ColumnSpan="2" HorizontalAlignment="Center" x:Name="loginErrorTextbox" FontSize="10" Foreground="Red" Visibility="Hidden" FontWeight="Light"/>
                </Grid>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    Register
                </TabItem.Header>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="20"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Column="1" Grid.Row="1" Content="Username"/>
                    <TextBox Grid.Column="2" Grid.Row="1" Margin="5" x:Name="RegUsernameInput" Width="200"/>
                    
                    <Label Grid.Column="1" Grid.Row="2" Content="Email"/>
                    <TextBox Grid.Column="2" Grid.Row="2" Margin="5" x:Name="RegEmailInput" Width="200"/>

                    <Label Grid.Column="1" Grid.Row="3" Content="Password"/>
                    <PasswordBox Grid.Column="2" Grid.Row="3" Margin="5" x:Name="RegPasswordInput" Width="200"/>
                    
                    <Label Grid.Column="1" Grid.Row="4" Content="Password"/>
                    <PasswordBox Grid.Column="2" Grid.Row="4" Margin="5" x:Name="RegPassword2ndInput" Width="200"/>

                    <Button Grid.Column="1" Grid.Row="5" Grid.ColumnSpan="2" x:Name="RegisterButton" FontWeight="SemiBold" FontSize="12" Content="Register account" Margin="2"/>

                    <TextBlock Grid.Column="1" Grid.Row="7" Grid.ColumnSpan="2" HorizontalAlignment="Center" FontWeight="Light" FontSize="12" Foreground="Red"/>
                </Grid>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    Options
                </TabItem.Header>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="20"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Column="1" Grid.Row="1" Content="Hostname"/>
                    <TextBox Grid.Column="2" Grid.Row="1" Margin="5" x:Name="OptHostname" Width="200" TextChanged="OptHostname_TextChanged"/>

                    <Label Grid.Column="1" Grid.Row="2" Content="Port"/>
                    <TextBox Grid.Column="2" Grid.Row="2" Margin="5" x:Name="OptNetworkPort" Width="200" PreviewTextInput="IsInputUInt16" TextChanged="OptNetworkPort_TextChanged"/>

                    <Button Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="2" Margin="5"
                            x:Name="ConnectionTestButton" Content="Test Connection"/>

                    <CheckBox x:Name="CollarConnectCheckbutton" Grid.Column="1" Grid.Row="4" Grid.ColumnSpan="2" Margin="0, 5, 0, 0" Content="CollarConnect"/>

                    <Border Grid.Column="1" Grid.Row="5" Grid.ColumnSpan="2" Height="115" Width="auto"
                            x:Name="SerialBox" BorderThickness="3" BorderBrush="LightGray" CornerRadius="5"
                            IsEnabled="False">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>


                            <Label Grid.Column="1" Grid.Row="0" Content="Port"/>
                            <TextBox Grid.Column="2" Grid.Row="0" Margin="5" x:Name="OptSerialPort"/>

                            <Label Grid.Column="1" Grid.Row="1" Content="Baudrate"/>
                            <TextBox Grid.Column="2" Grid.Row="1" Margin="5" x:Name="OptSerialBaud"/>

                            <Button Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="2"
                            x:Name="CollarConnectionTestButton" Content="Test Connection"/>
                        </Grid>
                    </Border>

                    <Popup Grid.Column="1" Grid.Row="5" Name="Popup1" Width="200" Height="75" IsOpen="False" Placement="Mouse">
                        <Grid Background="LightGray">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="PopupText" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                            <Button x:Name="PopupOkButton" Grid.Row="1" Content="Ok"/>
                        </Grid>
                    </Popup>
                </Grid>
            </TabItem>
        </TabControl>
    </Border>
</Window>
