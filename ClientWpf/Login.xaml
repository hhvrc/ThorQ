<Window x:Class="ThorQ.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ThorQ"
        mc:Ignorable="d"
        Title="ThorQ Login" Height="242.589" Width="350" FontSize="18" Background="#323232">
    <Border BorderThickness="5">
        <Grid>
            <Popup Name="InfoPopup" Width="200" Height="75" IsOpen="False" Placement="Mouse">
                <Grid Background="LightGray">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="InfoPopupText" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                    <Button x:Name="InfoPopupOkButton" Grid.Row="1" Content="Ok"/>
                </Grid>
            </Popup>
            <TabControl Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" Height="auto" Background="#323232">
                <TabItem>
                    <TabItem.Header>
                        Login
                    </TabItem.Header>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="20"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Column="1" Grid.Row="1" Content="Displayname"/>
                        <TextBox Grid.Column="2" Grid.Row="1" Margin="5" x:Name="DisplaynameInput" Width="200"/>

                        <Button Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2" x:Name="LoginButton" FontWeight="SemiBold" IsEnabled="False" FontSize="12" Content="Login" Margin="2"/>


                        <TextBlock Grid.Column="1" Grid.Row="5" Grid.ColumnSpan="2" HorizontalAlignment="Center" x:Name="loginErrorTextbox" FontSize="10" Foreground="Red" Visibility="Hidden" FontWeight="Light"/>
                    </Grid>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        Options
                    </TabItem.Header>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="20"/>
                        </Grid.RowDefinitions>

                        <CheckBox x:Name="CollarConnectMenuToggleCheckBox" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" Margin="0, 5, 0, 0" Content="CollarConnect"/>

                        <Border Grid.Column="1" Grid.Row="2" Width="auto"
                            x:Name="SerialBox" BorderThickness="3" BorderBrush="LightGray" CornerRadius="5"
                            IsEnabled="False" Margin="0,0,0,38" Grid.RowSpan="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Column="1" Grid.Row="0" Content="Port"/>
                                <ComboBox Grid.Column="2" Grid.Row="0" Margin="5" Height="25" x:Name="CollarConnectPortSelector"/>

                                <Button Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="2" x:Name="CollarConnectTestButton" Content="Test Connection" IsEnabled="False"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
