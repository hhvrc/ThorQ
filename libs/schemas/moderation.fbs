include "uuid.fbs";

namespace ThorQ.Serialization.Moderation;

table Ban {
  time : ulong;
  reason : string;
}

table Report {
  user_id : Uuid;
  reason : string;
}

/// Yada, yada...
union Body {
  ban : Moderation.Ban,
  report : Moderation.Report
}

table Message {
  body : Moderation.Body;
}
