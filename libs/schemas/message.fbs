include "account.fbs";
include "announcement.fbs";
include "crypto.fbs";
include "files.fbs";
include "heartbeat.fbs";
include "moderation.fbs";
include "group.fbs";
include "systemid.fbs";
include "uuid.fbs";
include "version.fbs";

namespace ThorQ.Serialization;

union Message {
  heartbeat : Heartbeat,
  account : Account.Message,
  announcement : Announcement,
  crypto : Crypto.Message,
  moderation : Moderation.Message,

}

table MessageBuffer {
  sequence : ulong;
  message_array : [ Message ];
}

root_type MessageBuffer;
