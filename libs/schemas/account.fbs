include "uuid.fbs";
include "user.fbs";
include "file.fbs";

namespace ThorQ.Serialization.Account;

struct AuthToken {
  token : [ ubyte : 64 ];
}
struct HashingSalt {
  salt : [ ubyte : 16 ];
}
struct HashingParameters {
  ops_limit : long;
  mem_limit : long;
  algorithm : int;
}
struct HashCalculated {
  hash : [ ubyte : 32 ];
}
struct HashNew {
  hash : [ ubyte : 32 ];
  params : Account.HashingParameters;
}

table GetAccountId {
  username : string;
}

table GetHashingSalt {
  account_id : Uuid;
}

table GetHashingParameters {
  account_id : Uuid;
}

table LoginRequest {
  account_id : Uuid;
  password_hash : Account.HashCalculated;
  get_auth_token : bool;
}

table LoginResponse {
  success : bool;
  account_id : Uuid;
  auth_token : Account.AuthToken;
}

table RegistrationRequest {
  account_id : Uuid;
  email : string;
  password_hash : Account.HashNew;
}

table RegistrationResponse {
  success : bool;
  account_id : Uuid;
}

table Recover {
  email : string;
}

table Delete {
  password_hash : Account.HashCalculated;
}

table Logout {
  logout_all : bool;
}

table SetUsername {
  username : string;
  password_hash : Account.HashCalculated;
}

table SetPassword {
  new_password_hash : Account.HashNew;
}

table SetEmail {
  email : string;
  password_hash : Account.HashCalculated;
}

table SetImage {
  image : [ ubyte ];
}

/// Yada, yada...
union Body {
  get_account_id : Account.GetAccountId,
  account_id : Uuid,

  get_hashing_salt : Account.GetHashingSalt,
  hashing_salt : Account.HashingSalt,

  get_hashing_parameters : Account.GetHashingParameters,
  hashing_parameters : Account.HashingParameters,

  login_request : Account.LoginRequest,
  login_response : Account.LoginResponse,

  registration_request : Account.RegistrationRequest,
  registration_response : Account.RegistrationResponse,

  recover : Account.Recover,
  delete : Account.Delete,
  logout : Account.Logout,

  set_username : Account.SetUsername,
  set_password : Account.SetPassword,
  set_email : Account.SetEmail,
  set_image : Account.SetImage
}

table Message {
  body : Account.Body;
}
