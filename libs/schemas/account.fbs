include  "uuid.fbs";

namespace ThorQ.Serialization.Account;

struct AuthToken {
  token:[ubyte:64];
}

enum AccountCommandCode : ubyte {
  Register,
  Delete,
  LoginCookie,
  LoginPassword,
  Logout,
  LogoutAll,
  Recover
}

table AccountCommand {
  cmd:AccountCommandCode;
  username:string;
  password:string;
  auth_token:AuthToken;
  discord_id:string;
  remember_me:bool;
}

enum AccountResponseCode : ubyte {
  Ok,
  Denied,
  Created,
  Removed,
  Error
}

table AccountResponse {
  response:AccountResponseCode;
  explenation:string;
  session_cookie:[ubyte];
}
